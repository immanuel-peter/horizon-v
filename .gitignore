.DS_Store
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

.env
.env.*
!.env.example

/models/
/checkpoints/
/data/
/outputs/
/runs/
/third_party/

# hf/<name>/ is the Hugging Face repo working tree: authored files are tracked, weights and per-build
# outputs are not (written by k2hv.build_init).
/hf/*/*.safetensors
/hf/*/model.safetensors.index.json
/hf/*/tokenizer.json
/hf/*/build_info.json
/hf/*/SHA256SUMS
/hf/*/.building/
/hf/*/.cache/
